---
// Direction 2, "Studio": premium and quiet. The page colour matches the photo backdrop,
// so the cookies sit directly on the page. Monochrome, black buttons, a sideways-scrolling lineup.
import { Image } from 'astro:assets';
import { cookies } from '../data/cookies';
import { site } from '../site';
import heroShot from '../assets/lifestyle/gooey-pair.jpg';

const orderLinks = site.orderLinks.filter((l) => l.url);
---

<div class="studio">
  <header class="nav">
    <a href="#studio-top" class="logo">BATCH</a>
    <nav class="links" aria-label="Main">
      <a href="#studio-cookies">Cookies</a>
      <a href="#studio-order">Order</a>
    </nav>
  </header>

  <section class="hero" id="studio-top">
    <div class="hero__copy">
      <p class="eyebrow">Dubai and Abu Dhabi</p>
      <h1>Cookies, taken seriously.</h1>
      <p class="hero__sub">Slow-baked every day, with centres that stay soft and gooey.</p>
      <div class="hero__cta">
        <a href="#studio-order" class="btn">Order now</a>
        <a href="#studio-cookies" class="textlink">See the lineup</a>
      </div>
    </div>
    <div class="hero__photo">
      <!-- Swap for the Higgsfield hero video once it is generated. -->
      <Image src={heroShot} alt="A Kind of Nuts cookie broken open, Nutella running out" widths={[600, 900, 1200]} sizes="(max-width: 860px) 100vw, 50vw" loading="eager" />
    </div>
  </section>

  <section class="lineup" id="studio-cookies">
    <div class="lineup__head">
      <h2>The lineup</h2>
      <div class="rail-controls">
        <button type="button" class="arrow" data-dir="-1" aria-label="Previous cookies">&larr;</button>
        <button type="button" class="arrow" data-dir="1" aria-label="Next cookies">&rarr;</button>
      </div>
    </div>
    <ul class="rail" role="list">
      {
        cookies.map((c) => (
          <li class="item">
            <Image src={c.image} alt={c.name} width={720} height={720} fit="cover" position="center" />
            <h3>{c.name}</h3>
            <p>{c.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="order" id="studio-order">
    <h2>Order on</h2>
    <div class="order__links">
      {orderLinks.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} <span aria-hidden="true">&nearr;</span></a>)}
    </div>
  </section>

  <footer class="foot">
    <span>&copy; {new Date().getFullYear()} BATCH</span>
    <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>
  </footer>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.studio').forEach((root) => {
    const rail = root.querySelector<HTMLElement>('.rail');
    root.querySelectorAll<HTMLButtonElement>('.arrow').forEach((btn) =>
      btn.addEventListener('click', () => {
        if (!rail) return;
        rail.scrollBy({ left: Number(btn.dataset.dir) * rail.clientWidth * 0.8, behavior: 'smooth' });
      }),
    );
  });
</script>

<style>
  .studio {
    --bg: #eceae8;
    --ink: #1d1c1b;
    --muted: #6c6966;
    color-scheme: light;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Geist Variable', system-ui, sans-serif;
  }
  h1, h2, h3 { margin: 0; font-weight: 500; letter-spacing: -0.04em; line-height: 1; text-wrap: balance; }
  p { margin: 0; }
  a { color: inherit; text-decoration: none; }

  .nav { display: flex; justify-content: space-between; align-items: center; height: 72px; padding: 0 clamp(16px, 4vw, 56px); }
  .logo { font-weight: 600; letter-spacing: 0.32em; font-size: 0.95rem; }
  .links { display: flex; gap: 2rem; font-size: 0.95rem; }
  .links a:hover, .textlink:hover { text-decoration: underline; text-underline-offset: 5px; }

  .hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; min-height: calc(100svh - 72px); padding: 0 0 0 clamp(16px, 4vw, 56px); }
  .eyebrow { font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .hero h1 { margin-top: 1.25rem; font-size: clamp(3rem, 6.4vw, 6rem); max-width: 10ch; }
  .hero__sub { margin-top: 1.5rem; max-width: 30ch; font-size: 1.1875rem; color: var(--muted); line-height: 1.5; }
  .hero__cta { display: flex; align-items: center; gap: 1.75rem; margin-top: 2.5rem; }
  .btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 1.75rem; border-radius: 999px; background: var(--ink); color: var(--bg); font-weight: 500; transition: transform 160ms var(--ease-out); }
  .btn:active { transform: scale(0.97); }
  .textlink { font-weight: 500; }
  .hero__photo {
    height: 100%; max-height: calc(100svh - 72px); overflow: hidden;
    /* Feather the edges so the photo's backdrop melts into the page colour. */
    mask-image: linear-gradient(to right, transparent, #000 22%), linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
    mask-composite: intersect;
  }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; animation: settle 1400ms var(--ease-out) both; }
  .hero__copy > * { animation: fade 900ms var(--ease-out) both; }
  .hero__copy > :nth-child(2) { animation-delay: 80ms; }
  .hero__copy > :nth-child(3) { animation-delay: 160ms; }
  .hero__copy > :nth-child(4) { animation-delay: 240ms; }

  .lineup { padding: clamp(5rem, 10vw, 9rem) 0 clamp(4rem, 8vw, 7rem); }
  .lineup__head { display: flex; justify-content: space-between; align-items: end; padding: 0 clamp(16px, 4vw, 56px); }
  .lineup h2 { font-size: clamp(2.5rem, 5vw, 4.25rem); }
  .rail-controls { display: flex; gap: 0.5rem; }
  .arrow { width: 48px; height: 48px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--ink) 25%, transparent); background: transparent; color: var(--ink); font-size: 1.125rem; cursor: pointer; transition: background-color 160ms var(--ease-out), transform 160ms var(--ease-out); }
  .arrow:hover { background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .arrow:active { transform: scale(0.95); }
  .rail {
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(240px, 26vw, 380px); gap: clamp(16px, 2vw, 28px);
    margin: 2.5rem 0 0; padding: 0 clamp(16px, 4vw, 56px) 1rem; list-style: none;
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 clamp(16px, 4vw, 56px); scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  .item { scroll-snap-align: start; }
  .item img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; mask-image: radial-gradient(closest-side, #000 78%, transparent); }
  .item h3 { margin-top: 1rem; font-size: 1.375rem; letter-spacing: -0.02em; }
  .item p { margin-top: 0.4rem; color: var(--muted); font-size: 0.95rem; line-height: 1.5; max-width: 32ch; }

  .order { padding: clamp(4rem, 9vw, 8rem) clamp(16px, 4vw, 56px); background: var(--ink); color: var(--bg); }
  .order h2 { font-size: 1rem; letter-spacing: 0; color: color-mix(in srgb, var(--bg) 60%, transparent); }
  .order__links { display: flex; flex-wrap: wrap; gap: 0 clamp(2rem, 5vw, 5rem); margin-top: 1.5rem; }
  .order__links a { font-size: clamp(3rem, 8vw, 7rem); letter-spacing: -0.05em; line-height: 1.05; transition: opacity 160ms var(--ease-out); }
  .order__links a:hover { opacity: 0.7; }
  .order__links span { font-size: 0.5em; vertical-align: 0.4em; }

  .foot { display: flex; justify-content: space-between; padding: 2rem clamp(16px, 4vw, 56px) 6rem; font-size: 0.9rem; color: var(--muted); background: var(--ink); }
  .foot a { color: var(--bg); }

  @keyframes fade { from { opacity: 0; transform: translateY(12px); } }
  @keyframes settle { from { transform: scale(1.08); } }
  @media (prefers-reduced-motion: reduce) { .hero__photo img, .hero__copy > * { animation: none; } }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding: 0; min-height: 0; }
    .hero__copy { padding: 2.5rem 16px 3rem; }
    .hero__photo { order: -1; height: 62svh; }
    .rail { grid-auto-columns: 72vw; }
  }
</style>
