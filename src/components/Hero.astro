---
import { site } from '../site';
// Until site.hero.video is set (16:9 silent loop from Higgsfield), a placeholder backdrop shows.
const { headline, subtext, video, poster } = site.hero;
---

<section class="hero">
  <div class="container">
    <div class="hero__frame">
      {
        video ? (
          <video class="hero__media" autoplay muted loop playsinline preload="auto" poster={poster || undefined} aria-hidden="true">
            <source src={video} type="video/mp4" />
          </video>
        ) : (
          <div class="hero__media hero__media--placeholder" aria-hidden="true" />
        )
      }
      <div class="hero__content">
        <h1 class="hero__headline">{headline}</h1>
        <p class="hero__subtext">{subtext}</p>
        <div class="hero__actions">
          <a href="#order" class="button hero__primary">Order now</a>
          <a href="#cookies" class="button hero__secondary">See the cookies</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__frame {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(calc(100svh - var(--header-height) - 1rem), 860px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    isolation: isolate;
    background: #2a1d16;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero__media--placeholder {
    background:
      radial-gradient(circle at 72% 38%, #8a5a36 0, transparent 38%),
      radial-gradient(circle at 30% 80%, #4a3021 0, transparent 45%),
      #2a1d16;
  }
  /* Scrim keeps the white text readable over any video frame. */
  .hero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(10 8 6 / 0.72) 0%, rgb(10 8 6 / 0.25) 45%, transparent 70%);
  }
  .hero__content {
    width: 100%;
    max-width: 64rem;
    padding: clamp(1.5rem, 5vw, 4rem);
    color: #ffffff;
  }
  .hero__headline {
    font-size: clamp(3rem, 7.5vw, 6.5rem);
    line-height: 0.92;
  }
  .hero__subtext {
    max-width: 32ch;
    margin-top: 1.25rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    color: rgb(255 255 255 / 0.86);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__primary {
    background: #ffffff;
    color: #131316;
  }
  .hero__primary:hover {
    background: #ecebe7;
  }
  .hero__secondary {
    background: rgb(255 255 255 / 0.14);
    color: #ffffff;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .hero__secondary:hover {
    background: rgb(255 255 255 / 0.24);
  }
  @media (max-width: 640px) {
    .hero__frame {
      min-height: min(calc(100svh - var(--header-height) - 1rem), 720px);
    }
  }
</style>
