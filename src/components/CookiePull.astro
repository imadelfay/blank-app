---
// A full-width, silent loop of a cookie being pulled apart, placed between the lineup and the tins.
const src = '/media/cookie-pull-bisc-please.mp4';
const poster = '/media/cookie-pull-bisc-please.jpg';
---

<section class="pull" aria-label="Bisc, Please pulled apart">
  <video class="pull__video" src={src} poster={poster} muted loop playsinline preload="metadata"></video>
  <button class="pull__toggle" type="button" aria-label="Pause video" hidden>
    <svg class="pull__icon pull__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="6" y="5" width="4" height="14" rx="1"></rect>
      <rect x="14" y="5" width="4" height="14" rx="1"></rect>
    </svg>
    <svg class="pull__icon pull__icon--play" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"></path>
    </svg>
  </button>
</section>

<script>
  for (const section of document.querySelectorAll<HTMLElement>('.pull')) {
    const video = section.querySelector('video')!;
    const toggle = section.querySelector<HTMLButtonElement>('.pull__toggle')!;

    const setPaused = (paused: boolean) => {
      section.classList.toggle('is-paused', paused);
      toggle.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
    };

    // Reduced motion: keep the poster frame and let people start it themselves.
    let userPaused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    toggle.hidden = false;
    setPaused(true);

    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) video.pause();
      else video.play().catch(() => {});
    });
    video.addEventListener('play', () => setPaused(false));
    video.addEventListener('pause', () => setPaused(true));

    // Only play while on screen, so it starts at the tear rather than mid-loop.
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !userPaused) video.play().catch(() => {});
        else if (!entry.isIntersecting) video.pause();
      },
      { threshold: 0.4 },
    ).observe(section);
  }
</script>

<style>
  .pull {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: #e9e7e6;
    aspect-ratio: 16 / 9;
    max-height: 80vh;
  }
  .pull__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pull__toggle {
    position: absolute;
    right: 16px;
    bottom: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(35 31 32 / 0.55);
    color: var(--brand-white);
    cursor: pointer;
    transition: background-color 150ms var(--ease-out);
  }
  .pull__toggle:hover {
    background: rgb(35 31 32 / 0.8);
  }
  .pull__toggle:focus-visible {
    outline: 3px solid var(--brand-yellow);
    outline-offset: 2px;
  }
  .pull__icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .pull__icon--play,
  .pull.is-paused .pull__icon--pause {
    display: none;
  }
  .pull.is-paused .pull__icon--play {
    display: block;
  }
  @media (max-width: 760px) {
    .pull {
      aspect-ratio: 4 / 3;
    }
  }
</style>
