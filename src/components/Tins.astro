---
import { Image } from 'astro:assets';
import { tins } from '../data/tins';
---

<section id="tins" class="tins">
  <div class="tins__head">
    <h2>Tins, made for sharing.</h2>
    <p>Baked in the tin, delivered hot and gooey. Grab a spoon and dig in together.</p>
  </div>
  <ul class="tins__grid" role="list">
    {
      tins.map((t) => (
        <li class="tin" id={t.slug}>
          <div class="tin__photo">
            <Image
              src={t.image}
              alt={`${t.name} cookie tin with a spoonful lifted out`}
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 760px) 86vw, (max-width: 1100px) 45vw, 30vw"
              width={1200}
              height={1200}
            />
            {t.topImage && (
              <Image
                class="tin__top"
                src={t.topImage}
                alt=""
                widths={[480, 720, 960, 1200]}
                sizes="(max-width: 760px) 86vw, (max-width: 1100px) 45vw, 30vw"
                width={1200}
                height={1200}
              />
            )}
          </div>
          <h3>{t.name}</h3>
          <p>{t.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .tins {
    margin-block: var(--space-section);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius);
    background: var(--brand-black);
    color: var(--brand-white);
  }
  /* In dark mode the page is already black, so lift the panel slightly. */
  @media (prefers-color-scheme: dark) {
    .tins {
      background: var(--color-card);
    }
  }
  .tins__head {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: end;
    gap: 1rem 2rem;
  }
  h2 {
    font-size: clamp(2.75rem, 6vw, 5rem);
  }
  .tins__head p {
    margin: 0;
    font-size: 1.1875rem;
    color: #d6d1d3;
  }
  .tins__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 20px);
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .tin {
    scroll-margin-top: calc(var(--header-height) + 16px);
  }
  .tin__photo {
    position: relative;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) - 8px);
    overflow: hidden;
  }
  .tin__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tin:hover .tin__photo img {
      transform: scale(1.04);
    }
  }
  /* Same pattern as the cookie cards: the overhead shot fades to the spoon scoop on hover,
     and touch screens only ever see the scoop. */
  .tin__photo .tin__top {
    display: none;
  }
  @media (hover: hover) {
    .tin__photo .tin__top {
      display: block;
      position: absolute;
      inset: 0;
      transition:
        opacity 300ms var(--ease-out),
        transform 500ms var(--ease-out);
    }
    .tin:hover .tin__top {
      opacity: 0;
    }
  }
  h3 {
    margin: 1.25rem 0.25rem 0;
    font-size: clamp(1.5rem, 2.2vw, 1.875rem);
    color: var(--brand-yellow);
  }
  .tin p {
    margin: 0.5rem 0.25rem 0;
    font-size: 1rem;
    line-height: 1.5;
    color: #d6d1d3;
  }
  @media (max-width: 1100px) {
    .tins__head {
      grid-template-columns: 1fr;
    }
  }
  /* Phones: a swipeable row so each tin photo stays large. */
  @media (max-width: 760px) {
    .tins__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 86%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * clamp(2rem, 6vw, 5rem));
      padding-inline: clamp(2rem, 6vw, 5rem);
      scroll-padding-inline: clamp(2rem, 6vw, 5rem);
    }
    .tins__grid::-webkit-scrollbar {
      display: none;
    }
    .tin {
      scroll-snap-align: start;
    }
  }
</style>
