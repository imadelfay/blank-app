---
import { site } from '../site';
---

<footer class="footer">
  <div class="footer__brand">
    <span class="wordmark wordmark--edition" aria-hidden="true"></span>
    <p class="footer__signoff">it's focking good.</p>
    <span class="visually-hidden">{site.name}</span>
  </div>
  <div class="footer__links">
    {site.social.instagram && <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>}
    {site.social.tiktok && <a href={site.social.tiktok} target="_blank" rel="noopener">TikTok</a>}
  </div>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    padding-block: 3rem;
    font-weight: 600;
  }
  .footer__brand {
    width: clamp(180px, 26vw, 340px);
  }
  .footer__signoff {
    margin-top: 0.9rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .footer__links {
    display: flex;
    gap: 1.5rem;
  }
  .footer__links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
