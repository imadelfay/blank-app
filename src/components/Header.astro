---
import { site } from '../site';
---

<header class="header">
  <a href="/" class="header__brand">
    <span class="wordmark" aria-hidden="true"></span>
    <span class="visually-hidden">{site.name} home</span>
  </a>
  <nav class="header__nav" aria-label="Main">
    <a href="#cookies" class="header__link">Cookies</a>
    <a href="#tins" class="header__link">Tins</a>
    <a href="#brownies" class="header__link">Brownies</a>
    <a href="#order" class="pill pill--cta header__cta">Order now</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .header__brand {
    width: clamp(96px, 10vw, 124px);
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-weight: 600;
  }
  .header__link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .header__cta {
    min-height: 42px;
  }
  @media (max-width: 480px) {
    .header__link {
      display: none;
    }
  }
</style>
