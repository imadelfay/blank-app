---
import { site } from '../site';
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__brand">{site.name}</a>
  </div>
</header>

<style>
  .header {
    padding-block: 1.25rem;
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .header__brand {
    font-family: var(--font-display);
    font-size: 1.375rem;
    text-decoration: none;
  }
</style>
