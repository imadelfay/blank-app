---
import { Image } from 'astro:assets';
import { cookies } from '../data/cookies';
---

<section id="cookies" class="lineup">
  <h2>The lineup</h2>
  <p class="lineup__intro">Ten flavours, baked fresh every day. Pick your favourite.</p>
  <ul class="grid" role="list">
    {
      cookies.map((c) => (
        <li class="card" style={`--tint: ${c.tint}`}>
          <div class="card__photo">
            <Image src={c.image} alt={c.name} width={640} height={640} fit="cover" position="center" />
          </div>
          <h3>{c.name}</h3>
          <p>{c.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .lineup {
    padding-block: var(--space-section);
  }
  h2 {
    font-size: clamp(2.75rem, 6vw, 5rem);
  }
  .lineup__intro {
    margin-top: 1rem;
    font-size: 1.1875rem;
    color: var(--color-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 20px);
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    padding: 12px 12px 22px;
    border-radius: var(--radius);
    background: var(--tint);
    color: var(--color-card-text);
  }
  .card__photo {
    aspect-ratio: 1;
    border-radius: calc(var(--radius) - 10px);
    overflow: hidden;
  }
  .card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .card:hover .card__photo img {
      transform: scale(1.06);
    }
  }
  h3 {
    margin: 1rem 0.5rem 0;
    font-size: 1.375rem;
  }
  .card p {
    margin: 0.5rem 0.5rem 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-card-muted);
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    h3 {
      font-size: 1.125rem;
    }
    .card p {
      font-size: 0.875rem;
    }
  }
</style>
