---
import { site } from '../site';
const orderLinks = site.orderLinks.filter((link) => link.url);
---

<section id="order" class="order">
  <div class="container">
    <div class="order__panel" data-reveal>
      <div>
        <h2 class="order__title">Craving one?</h2>
        <p class="order__text">Order BATCH on your favourite app. Delivered across Dubai and Abu Dhabi.</p>
      </div>
      <div class="order__actions">
        {
          orderLinks.map((link) => (
            <a class="button order__button" href={link.url} target="_blank" rel="noopener">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .order {
    padding-bottom: var(--space-section);
  }
  .order__panel {
    display: grid;
    gap: 2rem;
    align-items: end;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .order__title {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
  }
  .order__text {
    max-width: 34ch;
    margin-top: 1rem;
    font-size: 1.1875rem;
    opacity: 0.88;
  }
  .order__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }
  .order__button {
    min-width: 10rem;
    min-height: 56px;
    background: var(--color-on-accent);
    color: var(--color-accent);
    font-size: 1.125rem;
  }
  .order__button:hover {
    transform: translateY(-2px);
  }
  @media (max-width: 767px) {
    .order__panel {
      grid-template-columns: 1fr;
    }
    .order__actions {
      justify-content: flex-start;
    }
    .order__button {
      flex: 1 1 10rem;
    }
  }
</style>
