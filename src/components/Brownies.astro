---
import { Image } from 'astro:assets';
import { brownies } from '../data/brownies';
---

<section id="brownies" class="brownies">
  <div class="brownies__head">
    <h2>Brownies</h2>
    <p>Fudgy brownie bites, served cold. Mix your favourites in a box of 16 or 40.</p>
  </div>
  <ul class="brownies__grid" role="list">
    {
      brownies.map((b) => (
        <li class="brownie" id={b.slug}>
          <div class="brownie__photo">
            <Image src={b.image} alt={`${b.name} brownie, torn open`} width={640} height={640} />
          </div>
          <h3>{b.name}</h3>
          <p>{b.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .brownies {
    padding-block: 0 var(--space-section);
  }
  .brownies__head {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: end;
    gap: 1rem 2rem;
  }
  h2 {
    font-size: clamp(2.75rem, 6vw, 5rem);
  }
  .brownies__head p {
    margin: 0;
    font-size: 1.1875rem;
    color: var(--color-muted);
  }
  .brownies__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 20px);
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .brownie {
    scroll-margin-top: calc(var(--header-height) + 16px);
    padding: 12px 12px 22px;
    border-radius: var(--radius);
    background: var(--color-card);
  }
  .brownie__photo {
    aspect-ratio: 1;
    border-radius: calc(var(--radius) - 10px);
    overflow: hidden;
  }
  .brownie__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .brownie:hover .brownie__photo img {
      transform: scale(1.06);
    }
  }
  h3 {
    margin: 1rem 0.5rem 0;
    font-size: 1.375rem;
  }
  .brownie p {
    margin: 0.5rem 0.5rem 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  @media (max-width: 1100px) {
    .brownies__head {
      grid-template-columns: 1fr;
    }
    .brownies__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .brownies__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    h3 {
      font-size: 1.125rem;
    }
    .brownie p {
      font-size: 0.875rem;
    }
  }
</style>
